{
  "name": "hippo",
  "version": "0.2.0",
  "description": "Local dashboard for managing Claude Code configuration files",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "dev": "npx tauri dev",
    "build": "npx tauri build && ./scripts/install-app.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node scripts/demo-home.mjs && cd src-tauri && cargo run -q --example demo_snapshot -- /tmp/hippo-demo/home > ../src/client/demo/snapshot.json",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@picocss/pico": "^2.1.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "marked": "^14.1.4"
  }
}
