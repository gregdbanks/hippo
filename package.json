{
  "name": "claude-config-ui",
  "version": "1.0.0",
  "description": "Local dashboard for managing Claude Code configuration files",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "dev": "npx tauri dev",
    "build": "npx tauri build && ./scripts/extract-app.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=json --outputFile=../../vitest-results.json && cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1 && node ../study-buddy-platform/pulse-dashboard/bin/pulse.js --cwd . 2>/dev/null || true",
    "test:ui": "vitest run --reporter=json --outputFile=../../vitest-results.json",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1"
  },
  "devDependencies": {
    "@picocss/pico": "^2.1.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0"
  }
}
