{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Claude Config",
  "version": "0.2.0",
  "identifier": "com.gregbanks.claude-config",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Config",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NEQ2N0FBNDQwMzVBN0YKUldSL1dnTkVxbWRONTZheis5RTZsUXEweHdDQzdNK0c0Z1dLM01RQWRFcHB1Y2lyWUNWVjhsa0oK",
      "endpoints": [
        "https://github.com/gregdbanks/claude-config-ui/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
